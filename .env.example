# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Provider Configuration (gemini, groq, nvidia, openrouter)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_GREETING_MODEL=gemini-flash-lite-latest
GEMINI_BIG_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_MODEL=gemini-flash-latest

# PostgreSQL & pgvector Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db
PGVECTOR_DIMENSION=768
PGSSL=false
RESUME_PDF_PATH=data/resume.pdf

# Groq Configuration (Alternative fast free provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM Configuration (Backup)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# OpenRouter Configuration (Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Any model on OpenRouter: openrouter/free (100% free auto-router), google/gemma-4-31b-it:free, openai/gpt-4o-mini, etc.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=PortfolioAIAgent

# Redis Configuration (For BullMQ & OTP caching)
# Docker is not needed! Use localhost (local Redis), WSL2, or cloud (Upstash / Redis Cloud)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternatively, specify a full connection string:
# REDIS_URL=redis://default:password@localhost:6379

# Email / SMTP Configuration (Nodemailer for BullMQ worker)
# Leave SMTP_HOST empty to use ethereal.email automatic test accounts in development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vyshnav's Agent <noreply@example.com>"

# Security: Secret key used to sign hashed OTPs (Required in production)
OTP_SECRET=replace_with_a_strong_random_secret_in_production

# Admin API Key: Protects privileged endpoints (/api/ingest, /api/enquiries)
ADMIN_API_KEY=replace_with_a_strong_admin_api_key

# Host Contact Notification (Where to forward scheduled leads)
HOST_EMAIL=vyshnav@example.com

# Cross-Origin Resource Sharing (CORS)
# Set to * to allow all domains/subdomains, or comma-separated list: https://myfrontend.com,http://localhost:5173
CORS_ORIGIN=*

# LangSmith Tracking & Tracing (Optional)
# Sign up at https://smith.langchain.com to monitor token counts, latency, and agent traces
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-portfolio-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
