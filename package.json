{
  "name": "ai-portfolio-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-Agent Backend using LangGraph, OpenRouter, Pinecone, BullMQ, and Redis",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/workers/emailWorker.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "test:chat": "tsx src/scripts/cliChat.ts",
    "ingest:pdf": "tsx src/scripts/ingestResumePdf.ts",
    "test": "vitest run --no-file-parallelism"
  },
  "keywords": [
    "langgraph",
    "ai-agent",
    "openrouter",
    "pinecone",
    "bullmq",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.54",
    "@langchain/openai": "^0.4.4",
    "@pinecone-database/pinecone": "^5.0.2",
    "bullmq": "^5.41.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.5.0",
    "nodemailer": "^6.10.0",
    "openai": "^4.86.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
